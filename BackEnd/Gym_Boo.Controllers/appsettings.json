{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=Gym_BooDb;User Id=sa;Password=Password1234;TrustServerCertificate=true"
  },
  "Jwt": {
    "Key": "GymBoo-Super-Secret-Development-Key-123456789",
    "Issuer": "GymBoo.Api",
    "Audience": "GymBoo.React"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/warehouse-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Warehouse.Api"
    }
  },
  "AllowedHosts": "*"
}
